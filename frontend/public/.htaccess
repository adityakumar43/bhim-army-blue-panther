# For Hostinger (and any Apache / LiteSpeed server).
# Vite copies this file into dist/ when you run "npm run build".

# 1. Every address (like /join or /admin/members) opens the React app, which then shows the right page.
#    Without this, opening a link straight away or refreshing an inner page gives "404 Not Found".
Options -MultiViews
RewriteEngine On
RewriteBase /
# llms.txt (summary for AI assistants) is built live by the backend, with the current leaders
RewriteRule ^llms\.txt$ https://api.bhimarmybluepanther.org/llms.txt [R=302,L]
# Real files (pictures, scripts, styles) are sent as they are
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# 2. Caching: the page itself and the app's service worker are always checked for a new version,
#    so visitors get updates at once. Built files have a new name each build, so they can be kept long.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
    # Pictures and icons: kept for a week (a changed picture shows up within 7 days, or at once after a hard refresh)
  <If "%{REQUEST_URI} =~ m#\.(png|jpe?g|webp|svg|ico)$#">
    Header set Cache-Control "public, max-age=604800"
  </If>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
