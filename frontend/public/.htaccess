# For Hostinger (and any Apache / LiteSpeed server).
# Vite copies this file into dist/ when you run "npm run build".

# 1. Every address (like /join or /admin/members) opens the React app, which then shows the right page.
#    Without this, opening a link straight away or refreshing an inner page gives "404 Not Found".
Options -MultiViews -Indexes
# Do not add a / to addresses that match a folder (like /inspirations): the React page handles them
DirectorySlash Off
RewriteEngine On
RewriteBase /
# www.bhimarmybluepanther.org goes to bhimarmybluepanther.org: one official address for visitors and Google
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# llms.txt (summary for AI assistants) is built live by the backend, with the current leaders
RewriteRule ^llms\.txt$ https://api.bhimarmybluepanther.org/llms.txt [R=302,L]
# Real files (pictures, scripts, styles) are sent as they are. Folders are not: /inspirations is both a
# folder of photos and a page, and the page must win (otherwise a refresh shows a list of files)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# 2. Security: what browsers are told about this website
<IfModule mod_headers.c>
  # Other websites may not show these pages inside a frame (stops "clickjacking" of the admin panel)
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  # A file is only ever treated as the type the server says it is
  Header always set X-Content-Type-Options "nosniff"
  # Other sites see only "bhimarmybluepanther.org" as where a visitor came from, never the full address
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Browsers that have opened the site once over HTTPS always use HTTPS for it, for a year
  # (browsers ignore this line on a plain HTTP page, so it is safe to send on every answer)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Device features: only this site may use the camera (admin check-in scanner) and microphone (help desk voice
  # messages); nothing may ask for the visitor's location
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
</IfModule>

# 3. Caching: the page itself and the app's service worker are always checked for a new version,
#    so visitors get updates at once. Built files have a new name each build, so they can be kept long.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
    # Pictures and icons: kept for a week (a changed picture shows up within 7 days, or at once after a hard refresh)
  <If "%{REQUEST_URI} =~ m#\.(png|jpe?g|webp|svg|ico)$#">
    Header set Cache-Control "public, max-age=604800"
  </If>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
